{
    "name": "f1mtech/data-cleaner-laravel",
    "type": "project",
    "description": "F1 MTech Data Cleaning & 4-Category Course Categorization Platform",
    "keywords": ["laravel", "data-cleaning", "f1mtech", "course-categorization"],
    "license": "MIT",
    "require": {
        "php": "*",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^10.0",
        "laravel/sanctum": "^3.2",
        "laravel/tinker": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
